# VPS ຂອງເຈົ້າ: ເຂົ້າເວັບທີ່ http://62.171.159.75:8086/
# ຖ້າ port ຊົນກັບໂປຣແກຣມອື່ນ — ປ່ຽນ APP_PORT ເປັນຕົວເລກວ່າງ
# ─────────────────────────────────────────────────────────────

APP_PORT=8086
CI_ENV=production

DB_NAME=academy_lms
DB_USER=academy
DB_PASS=CHANGE_ME_STRONG
DB_ROOT_PASS=CHANGE_ME_STRONG
DB_PORT=3306

# Envato (CodeCanyon) purchase code verification (create your token in Envato and keep it secret)
ENVATO_PERSONAL_TOKEN=CHANGE_ME_ENVATO_TOKEN

